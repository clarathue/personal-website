# Vorlage für .env (gitignored). Werte aus dem EmailJS-Dashboard.
# Der Produktions-Build bricht ab, solange einer fehlt. Im Deploy kommen sie aus GitHub-Secrets.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
# Öffentlicher Site-Key von Google reCAPTCHA v2 (Checkbox), google.com/recaptcha/admin.
# Das Geheimnis (Secret Key) gehört nur ins EmailJS-Template. Lokal geht Googles Test-Schlüssel:
# 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI (die Checkbox zeigt dann eine Testwarnung).
VITE_RECAPTCHA_SITE_KEY=
